{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "build/**/*.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "worker/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
